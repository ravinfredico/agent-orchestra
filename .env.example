# Copy to .env and fill in what you use. .env is never committed.
# Leave ANTHROPIC_API_KEY unset to run on your Claude plan login.

# Gmail and Google Calendar MCP servers (the catalog entries stay "not set up" until these are set)
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=
GCAL_MCP_URL=
GCAL_MCP_TOKEN=

# Hosting (later): required before listening beyond 127.0.0.1
APP_TOKEN=
REPOS_ROOT=

# Push notifications with ntfy (https://ntfy.sh). Off while NTFY_URL or NTFY_TOPIC is empty.
# Install the ntfy app on your phone and subscribe to the same topic. Anyone who knows the topic
# can read it, so make it long and random, e.g.: python -c "import secrets; print('chacha-' + secrets.token_hex(8))"
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Where "open the run" links in pushes point. Your Cloudflare Tunnel URL once hosted.
PUBLIC_URL=http://127.0.0.1:8000
